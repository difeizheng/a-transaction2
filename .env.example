# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中排除，不会被提交）。
# 优先级：真实系统环境变量 > .env 文件 > config/config.yaml。

# OpenAI / OpenAI 兼容接口（SiliconFlow 等）
OPENAI_API_KEY=your-openai-or-compatible-key
OPENAI_BASE_URL=https://api.siliconflow.cn

# Anthropic Claude（如使用 claude provider）
CLAUDE_API_KEY=your-claude-api-key

# Tushare Pro token（需 2000 积分以上）
TUSHARE_TOKEN=your-tushare-token
